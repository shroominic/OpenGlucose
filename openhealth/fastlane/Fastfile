require "json"
require "logger"
require "securerandom"
require "digest"
require "time"

default_platform(:ios)

def required_option(options, key)
  value = options[key].to_s.strip
  UI.user_error!("Missing required option #{key}") if value.empty?
  value
end

def optional_option(options, key)
  value = options[key].to_s.strip
  value.empty? ? nil : value
end

def connect_api_app(options)
  api_key_path = required_option(options, :api_key_path)
  bundle_id = required_option(options, :bundle_id)
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(
    filepath: api_key_path
  )
  # Spaceship otherwise persists full App Store Connect response bodies under
  # /tmp, including beta-group public links and other audience metadata.
  Spaceship::ConnectAPI.client.test_flight_request_client.logger = Logger.new(
    File::NULL
  )
  app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("App Store Connect app not found for #{bundle_id}") unless app
  app
end

def external_groups(app)
  app.get_beta_groups.select { |group| group.is_internal_group == false }
end

def exact_external_group(
  app:,
  group_name:,
  group_id: nil,
  internal_group_name: nil,
  internal_group_id: nil,
  internal_tester_id: nil,
  external_tester_count: nil,
  external_tester_ids_sha256: nil
)
  all_groups = app.get_beta_groups
  unknown_groups = all_groups.reject do |group|
    classified = [true, false].include?(group.is_internal_group)
    automatic_classified = [true, false, nil].include?(group.has_access_to_all_builds)
    classified && automatic_classified
  end
  unless unknown_groups.empty?
    UI.user_error!(
      "Found #{unknown_groups.length} TestFlight group(s) with unknown " \
      "audience classification"
    )
  end
  automatic_external_groups = all_groups.select do |group|
    group.is_internal_group == false && group.has_access_to_all_builds == true
  end
  unless automatic_external_groups.empty?
    UI.user_error!(
      "External TestFlight groups with automatic access to all builds are " \
      "not allowed (found #{automatic_external_groups.length})"
    )
  end
  if internal_group_name && internal_group_id && internal_tester_id
    internal_group = exact_internal_automatic_group(
      app: app,
      group_name: internal_group_name,
      group_id: internal_group_id
    )
    require_exact_internal_group_tester(
      group: internal_group,
      expected_tester_id: internal_tester_id
    )
  end

  groups = all_groups.select do |group|
    group.is_internal_group == false && group.has_access_to_all_builds != true
  end
  matches = groups.select do |group|
    group.name == group_name && (group_id.nil? || group.id == group_id)
  end
  UI.user_error!(
    "Expected exactly one non-automatic external TestFlight group named " \
    "#{group_name}#{group_id ? " with ID #{group_id}" : ''}; found #{matches.length}"
  ) unless matches.one?
  match = matches.first
  UI.user_error!(
    "Approved external TestFlight group must not expose a public link"
  ) unless match.public_link_enabled == false
  require_exact_external_group_testers(
    group: match,
    expected_count: external_tester_count,
    expected_ids_sha256: external_tester_ids_sha256
  )
  match
end

def exact_internal_automatic_group(app:, group_name:, group_id:)
  all_groups = app.get_beta_groups
  unknown_groups = all_groups.reject do |group|
    classified = [true, false].include?(group.is_internal_group)
    automatic_classified = if group.is_internal_group == true
                             [true, false].include?(group.has_access_to_all_builds)
                           else
                             [true, false, nil].include?(group.has_access_to_all_builds)
                           end
    classified && automatic_classified
  end
  unless unknown_groups.empty?
    UI.user_error!(
      "Found #{unknown_groups.length} TestFlight group(s) with unknown " \
      "audience classification"
    )
  end
  automatic_external_groups = all_groups.select do |group|
    group.is_internal_group == false && group.has_access_to_all_builds == true
  end
  unless automatic_external_groups.empty?
    UI.user_error!(
      "External TestFlight groups with automatic access to all builds are " \
      "not allowed (found #{automatic_external_groups.length})"
    )
  end

  automatic_internal_groups = all_groups.select do |group|
    group.is_internal_group == true && group.has_access_to_all_builds == true
  end
  unexpected_automatic_internal_groups = automatic_internal_groups.reject do |group|
    group.id == group_id
  end
  unless unexpected_automatic_internal_groups.empty?
    UI.user_error!(
      "Found #{unexpected_automatic_internal_groups.length} unapproved " \
      "automatic internal TestFlight group(s)"
    )
  end

  matches = automatic_internal_groups.select do |group|
    group.id == group_id && group.name == group_name
  end
  UI.user_error!(
    "Expected exactly one automatic internal TestFlight group named " \
    "#{group_name} with ID #{group_id}; found #{matches.length}"
  ) unless matches.one?
  matches.first
end

def tester_relationship_ids(group)
  # Read only relationship linkage IDs. The resource endpoint would expose
  # tester names and email addresses, which are neither needed nor retained.
  responses = Spaceship::ConnectAPI.client.test_flight_request_client
    .get(
      "v1/betaGroups/#{group.id}/relationships/betaTesters",
      { limit: 200 }
    )
    .all_pages
  relationships = responses.flat_map do |response|
    Array(response.body["data"])
  end
  valid_linkages = relationships.all? do |relationship|
    relationship["type"] == "betaTesters" &&
      !relationship["id"].to_s.strip.empty?
  end
  UI.user_error!("Internal tester relationship response is invalid") unless
    valid_linkages
  tester_ids = relationships.map { |relationship| relationship["id"] }.sort
  UI.user_error!("Tester relationship response contains duplicates") unless
    tester_ids.uniq.length == tester_ids.length
  tester_ids
end

def require_exact_internal_group_tester(group:, expected_tester_id:)
  UI.user_error!("Internal tester ID is malformed") unless
    expected_tester_id.match?(/\A[A-Za-z0-9-]+\z/)
  tester_ids = tester_relationship_ids(group)
  UI.user_error!(
    "Approved internal TestFlight tester relationship is not exact"
  ) unless tester_ids == [expected_tester_id]
end

def require_exact_external_group_testers(
  group:,
  expected_count:,
  expected_ids_sha256:
)
  count = Integer(expected_count, 10)
  UI.user_error!("External tester count must be positive") unless count.positive?
  digest = expected_ids_sha256.to_s.downcase
  UI.user_error!("External tester ID digest is malformed") unless
    digest.match?(/\A[0-9a-f]{64}\z/)
  tester_ids = tester_relationship_ids(group)
  actual_digest = Digest::SHA256.hexdigest(tester_ids.join("\n"))
  UI.user_error!("Approved external TestFlight tester count is not exact") unless
    tester_ids.length == count
  UI.user_error!("Approved external TestFlight tester set is not exact") unless
    actual_digest == digest
  { count: count, ids_sha256: digest }
rescue ArgumentError
  UI.user_error!("External tester count must be a decimal integer")
end

def require_internal_only_build(build)
  require_build_audience_type(build: build, expected: "INTERNAL_ONLY")
end

def require_app_store_eligible_build(build)
  require_build_audience_type(build: build, expected: "APP_STORE_ELIGIBLE")
end

def require_build_audience_type(build:, expected:)
  response = Spaceship::ConnectAPI.client.test_flight_request_client.get(
    "v1/builds/#{build.id}"
  )
  data = response.body["data"]
  audience_type = data.is_a?(Hash) ? data.dig("attributes", "buildAudienceType") : nil
  UI.user_error!(
    "TestFlight build audience type is #{audience_type.inspect}; expected #{expected}"
  ) unless audience_type == expected
end

def exact_valid_build(app:, version:, build_number:)
  builds = Spaceship::ConnectAPI::Build.all(
    app_id: app.id,
    version: version,
    build_number: build_number,
    platform: "IOS",
    processing_states: "VALID"
  ).uniq(&:id)
  UI.user_error!(
    "Expected exactly one valid TestFlight build #{version} (#{build_number}); " \
    "found #{builds.length}"
  ) unless builds.one?
  Spaceship::ConnectAPI::Build.get(build_id: builds.first.id)
end

def disable_automatic_notification(build)
  detail = build.build_beta_detail
  UI.user_error!("TestFlight build has no beta detail") unless detail
  Spaceship::ConnectAPI.patch_build_beta_details(
    build_beta_details_id: detail.id,
    attributes: { autoNotifyEnabled: false }
  )
  refreshed = Spaceship::ConnectAPI::Build.get(build_id: build.id)
  UI.user_error!("Could not disable automatic tester notification") unless
    refreshed.build_beta_detail&.auto_notify_enabled == false
  refreshed
end

def associated_groups(app:, build:)
  app.get_beta_groups.select do |group|
    group.fetch_builds.any? { |candidate| candidate.id == build.id }
  end
end

def require_exact_external_association(
  app:,
  build:,
  approved_group:,
  approved_internal_group_id:,
  required:
)
  associated = associated_groups(app: app, build: build)
  associated_ids = associated.map(&:id)
  UI.user_error!("Build group association response contains duplicates") unless
    associated_ids.uniq.length == associated_ids.length
  unexpected = associated.reject do |group|
    group.id == approved_group.id ||
      (
        group.id == approved_internal_group_id &&
          group.is_internal_group == true &&
          group.has_access_to_all_builds == true
      )
  end
  unless unexpected.empty?
    UI.user_error!(
      "Build is associated with #{unexpected.length} unapproved beta group(s)"
    )
  end
  if required && associated.none? { |group| group.id == approved_group.id }
    UI.user_error!("Build is not associated with the approved external group")
  end
  internal = associated.select do |group|
    group.is_internal_group == true && group.has_access_to_all_builds == true
  end
  unless internal.one? && internal.first.id == approved_internal_group_id
    UI.user_error!("Build does not have exactly the approved automatic internal group")
  end
  expected_ids = [approved_internal_group_id]
  expected_ids << approved_group.id if required
  if required && associated_ids.sort != expected_ids.sort
    UI.user_error!("Build does not have the exact approved external audience")
  end
  associated
end

def require_exclusive_internal_association(app:, build:, approved_group:)
  associated = associated_groups(app: app, build: build)
  approved = associated.select { |group| group.id == approved_group.id }
  unexpected = associated.reject { |group| group.id == approved_group.id }
  unless approved.one? && unexpected.empty?
    UI.user_error!(
      "Expected the build to be associated only with the approved internal " \
      "TestFlight group; found #{associated.length} associated group(s), " \
      "including #{unexpected.length} unapproved group(s)"
    )
  end
end

def require_no_individual_testers(build)
  # The relationship endpoint returns only linkage IDs, not tester names or
  # email addresses. Count those resources without materializing identities.
  responses = Spaceship::ConnectAPI.client.test_flight_request_client
    .get(
      "v1/builds/#{build.id}/relationships/individualTesters",
      { limit: 200 }
    )
    .all_pages
  count = responses.sum { |response| Array(response.body["data"]).length }
  UI.user_error!(
    "Build has #{count} unapproved individually assigned tester(s)"
  ) unless count.zero?
end

def require_external_beta_review_metadata(app:)
  localizations = app.get_beta_app_localizations
  UI.user_error!("External beta review has no app localization") if
    localizations.empty?

  locale_keys = localizations.map { |localization| localization.locale.to_s.strip }
  UI.user_error!("External beta review localization has no locale") if
    locale_keys.any?(&:empty?)
  UI.user_error!("External beta review localizations contain duplicates") unless
    locale_keys.uniq.length == locale_keys.length
  localizations.each do |localization|
    UI.user_error!("External beta review description is missing") if
      localization.description.to_s.strip.empty?
    UI.user_error!("External beta review feedback email is missing") if
      localization.feedback_email.to_s.strip.empty?
  end

  responses = Spaceship::ConnectAPI.get_beta_app_review_detail(
    filter: { app: app.id },
    limit: 200
  ).all_pages
  details = responses.flat_map(&:to_models)
  UI.user_error!(
    "Expected exactly one external beta review detail; found #{details.length}"
  ) unless details.one?
  detail = details.first
  {
    "contact first name" => detail.contact_first_name,
    "contact last name" => detail.contact_last_name,
    "contact email" => detail.contact_email,
    "contact phone" => detail.contact_phone,
    "review notes" => detail.notes
  }.each do |label, value|
    UI.user_error!("External beta review #{label} is missing") if
      value.to_s.strip.empty?
  end
  UI.user_error!("External beta review demo-account flag is unknown") unless
    [true, false].include?(detail.demo_account_required)
  if detail.demo_account_required
    UI.user_error!("External beta review demo account name is missing") if
      detail.demo_account_name.to_s.strip.empty?
    UI.user_error!("External beta review demo account password is missing") if
      detail.demo_account_password.to_s.strip.empty?
  end
  true
end

def require_external_beta_review_submission(build:)
  refreshed = Spaceship::ConnectAPI::Build.get(
    build_id: build.id,
    includes: "betaAppReviewSubmission"
  )
  UI.user_error!("Could not refetch the exact external beta build") unless refreshed
  submission = refreshed.beta_app_review_submission
  UI.user_error!("Exact build has no external beta review submission") unless
    submission
  eligible_states = %w[WAITING_FOR_REVIEW IN_REVIEW APPROVED]
  UI.user_error!(
    "Exact build beta review submission has an ineligible state"
  ) unless eligible_states.include?(submission.beta_review_state)
  submission
end

def expected_upload_provenance(
  app:,
  build:,
  bundle_id:,
  version:,
  build_number:,
  source_commit:,
  ipa_sha256:
)
  commit = source_commit.to_s.downcase
  digest = ipa_sha256.to_s.downcase
  UI.user_error!("Upload provenance source commit is malformed") unless
    commit.match?(/\A[0-9a-f]{40,64}\z/)
  UI.user_error!("Upload provenance IPA SHA-256 is malformed") unless
    digest.match?(/\A[0-9a-f]{64}\z/)
  {
    "schemaVersion" => 1,
    "kind" => "testflightUploadProvenance",
    "appId" => app.id,
    "bundleId" => bundle_id,
    "buildId" => build.id,
    "version" => version,
    "buildNumber" => build_number,
    "sourceCommit" => commit,
    "ipaSha256" => digest
  }
end

def load_upload_provenance(path)
  receipt_stat = File.lstat(path)
  UI.user_error!("Upload provenance must be a regular non-symlink file") unless
    receipt_stat.file? && !receipt_stat.symlink?

  File.open(path, File::RDONLY | File::NOFOLLOW) do |file|
    opened_stat = file.stat
    UI.user_error!("Upload provenance changed during verification") unless
      opened_stat.file? &&
        opened_stat.dev == receipt_stat.dev &&
        opened_stat.ino == receipt_stat.ino
    UI.user_error!("Upload provenance must have mode 400") unless
      (opened_stat.mode & 0o777) == 0o400
    JSON.parse(file.read)
  end
rescue JSON::ParserError
  UI.user_error!("Upload provenance is not valid JSON")
rescue Errno::ENOENT, Errno::ELOOP
  UI.user_error!("Upload provenance changed during verification")
end

def require_upload_provenance(
  path:,
  app:,
  build:,
  bundle_id:,
  version:,
  build_number:,
  source_commit:,
  ipa_sha256: nil
)
  receipt = load_upload_provenance(path)
  expected_keys = %w[
    appId buildId buildNumber bundleId ipaSha256 kind recordedAtUtc
    schemaVersion sourceCommit version
  ]
  UI.user_error!("Upload provenance has an unexpected schema") unless
    receipt.keys.sort == expected_keys.sort
  UI.user_error!("Upload provenance IPA SHA-256 is malformed") unless
    receipt["ipaSha256"].to_s.match?(/\A[0-9a-f]{64}\z/)
  begin
    recorded_at = Time.iso8601(receipt["recordedAtUtc"].to_s)
  rescue ArgumentError
    UI.user_error!("Upload provenance timestamp is malformed")
  end
  UI.user_error!("Upload provenance timestamp is not UTC") unless
    recorded_at.utc_offset.zero? && receipt["recordedAtUtc"].to_s.end_with?("Z")
  expected = expected_upload_provenance(
    app: app,
    build: build,
    bundle_id: bundle_id,
    version: version,
    build_number: build_number,
    source_commit: source_commit,
    ipa_sha256: ipa_sha256 || receipt["ipaSha256"]
  )
  UI.user_error!("Upload provenance does not match the exact release") unless
    expected.all? { |key, value| receipt[key] == value }
  receipt
end

def create_upload_provenance(path:, expected:)
  receipt = expected.merge("recordedAtUtc" => Time.now.utc.iso8601)
  File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o400) do |file|
    file.chmod(0o400)
    file.write("#{JSON.generate(receipt)}\n")
    file.flush
    file.fsync
  end
  fsync_parent_directory(path)
  receipt
rescue Errno::EEXIST
  UI.user_error!("Upload provenance already exists")
rescue SystemCallError => error
  UI.user_error!(
    "Upload provenance could not be recorded (#{error.class}); do not " \
    "associate or notify this build"
  )
end

def expected_notification_receipt(
  app:,
  build:,
  group:,
  approved_internal_group_id:,
  associated_group_ids:,
  external_tester_count:,
  external_tester_ids_sha256:,
  bundle_id:,
  version:,
  build_number:,
  source_commit:,
  ipa_sha256:
)
  {
    "schemaVersion" => 3,
    "appId" => app.id,
    "bundleId" => bundle_id,
    "buildId" => build.id,
    "version" => version,
    "buildNumber" => build_number,
    "externalGroupId" => group.id,
    "automaticInternalGroupId" => approved_internal_group_id,
    "associatedGroupIds" => associated_group_ids.sort,
    "externalTesterCount" => Integer(external_tester_count, 10),
    "externalTesterIdsSha256" => external_tester_ids_sha256.downcase,
    "sourceCommit" => source_commit,
    "ipaSha256" => ipa_sha256
  }
end

def fsync_parent_directory(path)
  File.open(File.dirname(path), File::RDONLY) do |directory|
    directory.fsync
  end
end

def load_notification_receipt(path)
  receipt_stat = File.lstat(path)
  UI.user_error!("Notification receipt must be a regular non-symlink file") unless
    receipt_stat.file? && !receipt_stat.symlink?

  File.open(path, File::RDONLY | File::NOFOLLOW) do |file|
    opened_stat = file.stat
    UI.user_error!("Notification receipt changed during verification") unless
      opened_stat.file? &&
        opened_stat.dev == receipt_stat.dev &&
        opened_stat.ino == receipt_stat.ino
    mode = opened_stat.mode & 0o777
    UI.user_error!("Notification receipt must have mode 400 or 600") unless
      [0o400, 0o600].include?(mode)
    JSON.parse(file.read)
  end
rescue JSON::ParserError
  UI.user_error!("Notification receipt is not valid JSON")
rescue Errno::ENOENT, Errno::ELOOP
  UI.user_error!("Notification receipt changed during verification")
end

def notification_receipt_state(path:, expected:)
  return :absent unless File.exist?(path) || File.symlink?(path)

  receipt = load_notification_receipt(path)
  matches = expected.all? { |key, value| receipt[key] == value }
  UI.user_error!("Notification receipt does not match the exact release") unless matches

  claim_id = receipt["claimId"].to_s.strip
  claimed_at = receipt["claimedAtUtc"].to_s.strip
  UI.user_error!("Notification receipt has incomplete claim metadata") if
    claim_id.empty? || claimed_at.empty?

  case receipt["status"]
  when "complete"
    notification_id = receipt["notificationId"].to_s.strip
    notified_at = receipt["notifiedAtUtc"].to_s.strip
    UI.user_error!("Completed notification receipt is incomplete") if
      notification_id.empty? || notified_at.empty?
    :complete
  when "pending"
    UI.user_error!(
      "A durable notification claim is pending for this exact release. " \
      "Do not run concurrently or retry until the release owner reconciles " \
      "App Store Connect."
    )
  else
    UI.user_error!("Notification receipt has an unknown status")
  end
end

def create_notification_claim(path:, expected:)
  claim_id = SecureRandom.uuid
  claim = expected.merge(
    "status" => "pending",
    "claimId" => claim_id,
    "claimedAtUtc" => Time.now.utc.iso8601
  )
  File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
    file.chmod(0o600)
    file.write("#{JSON.generate(claim)}\n")
    file.flush
    file.fsync
  end
  fsync_parent_directory(path)
  claim_id
rescue Errno::EEXIST
  UI.user_error!(
    "A notification claim already exists. Do not run concurrently or retry " \
    "until the release owner reconciles App Store Connect."
  )
rescue SystemCallError => error
  UI.user_error!(
    "The durable notification claim could not be established " \
    "(#{error.class}). No notification was attempted; do not retry until " \
    "the release owner inspects the claim path."
  )
end

def complete_notification_claim(path:, expected:, claim_id:, notification_id:)
  completion_path = nil
  begin
    pending = load_notification_receipt(path)
    matches = expected.all? { |key, value| pending[key] == value }
    matches &&= pending["status"] == "pending"
    matches &&= pending["claimId"] == claim_id
    UI.user_error!("The durable notification claim changed after delivery") unless matches

    complete = pending.merge(
      "status" => "complete",
      "notificationId" => notification_id,
      "notifiedAtUtc" => Time.now.utc.iso8601
    )
    completion_path = "#{path}.complete.#{Process.pid}.#{SecureRandom.hex(16)}"
    File.open(
      completion_path,
      File::WRONLY | File::CREAT | File::EXCL,
      0o400
    ) do |file|
      file.chmod(0o400)
      file.write("#{JSON.generate(complete)}\n")
      file.flush
      file.fsync
    end
    File.rename(completion_path, path)
    fsync_parent_directory(path)
  rescue StandardError => error
    UI.user_error!(
      "Notification may have been sent, but the durable claim could not be " \
      "confirmed complete (#{error.class}). Do not retry until the release " \
      "owner reconciles App Store Connect."
    )
  ensure
    if completion_path && (File.exist?(completion_path) || File.symlink?(completion_path))
      begin
        File.unlink(completion_path)
      rescue SystemCallError
        # The enclosing mode-700 temporary release directory is removed by the
        # release script. Never mask the fail-closed delivery error above.
      end
    end
  end
end

def post_build_beta_notification_once(request_client:, build_id:)
  body = {
    data: {
      type: "buildBetaNotifications",
      relationships: {
        build: { data: { type: "builds", id: build_id } }
      }
    }
  }
  response = request_client.client.run_request(
    :post,
    "v1/buildBetaNotifications",
    JSON.generate(body),
    {
      "Content-Type" => "application/json",
      "User-Agent" => Spaceship::Client::USER_AGENT
    }
  )
  parsed_body = if response.body.is_a?(String)
                  JSON.parse(response.body)
                else
                  response.body
                end
  {
    status: response.status,
    body: parsed_body
  }
end

platform :ios do
  desc "Require the exact automatic internal group and its one approved tester"
  lane :verify_internal_group do |options|
    app = connect_api_app(options)
    expected_tester_id = required_option(options, :expected_tester_id)
    group = exact_internal_automatic_group(
      app: app,
      group_name: required_option(options, :group_name),
      group_id: required_option(options, :group_id)
    )
    require_exact_internal_group_tester(
      group: group,
      expected_tester_id: expected_tester_id
    )

    result_path = required_option(options, :result_path)
    File.open(result_path, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
      file.write(group.id)
    end
    UI.success("Verified the approved internal TestFlight group and tester count")
  end

  desc "Verify the exact build is available only to the approved internal group"
  lane :verify_internal_build do |options|
    app = connect_api_app(options)
    group_name = required_option(options, :group_name)
    group_id = required_option(options, :group_id)
    expected_tester_id = required_option(options, :expected_tester_id)
    group = exact_internal_automatic_group(
      app: app,
      group_name: group_name,
      group_id: group_id
    )
    require_exact_internal_group_tester(
      group: group,
      expected_tester_id: expected_tester_id
    )
    build = exact_valid_build(
      app: app,
      version: required_option(options, :version),
      build_number: required_option(options, :build_number)
    )
    require_internal_only_build(build)
    require_exclusive_internal_association(
      app: app,
      build: build,
      approved_group: group
    )
    require_no_individual_testers(build)

    # Re-resolve the audience after all build-audience reads so a concurrent
    # group or tester change fails closed before this lane succeeds.
    group = exact_internal_automatic_group(
      app: app,
      group_name: group_name,
      group_id: group_id
    )
    require_exact_internal_group_tester(
      group: group,
      expected_tester_id: expected_tester_id
    )
    require_exclusive_internal_association(
      app: app,
      build: build,
      approved_group: group
    )
    require_no_individual_testers(build)
    require_internal_only_build(build)
    UI.success("Verified the exact build has only the approved internal audience")
  end

  desc "Require one existing non-automatic external group and record its immutable ID"
  lane :verify_external_group do |options|
    app = connect_api_app(options)
    group_name = required_option(options, :group_name)
    expected_group_id = optional_option(options, :group_id)
    result_path = required_option(options, :result_path)
    group = exact_external_group(
      app: app,
      group_name: group_name,
      group_id: expected_group_id,
      internal_group_name: required_option(options, :internal_group_name),
      internal_group_id: required_option(options, :internal_group_id),
      internal_tester_id: required_option(options, :internal_tester_id),
      external_tester_count: required_option(options, :external_tester_count),
      external_tester_ids_sha256: required_option(
        options,
        :external_tester_ids_sha256
      )
    )

    File.open(result_path, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
      file.write(group.id)
    end
    UI.success("Verified the approved external TestFlight group")
  end

  desc "Fail closed unless external beta-review metadata is complete"
  lane :verify_external_review_metadata do |options|
    app = connect_api_app(options)
    require_external_beta_review_metadata(app: app)
    UI.success("Verified complete external beta-review metadata")
  end

  desc "Record immutable provenance for the exact processed external build"
  lane :record_external_upload_provenance do |options|
    app = connect_api_app(options)
    bundle_id = required_option(options, :bundle_id)
    version = required_option(options, :version)
    build_number = required_option(options, :build_number)
    source_commit = required_option(options, :source_commit)
    ipa_sha256 = required_option(options, :ipa_sha256)
    build = exact_valid_build(
      app: app,
      version: version,
      build_number: build_number
    )
    require_app_store_eligible_build(build)
    expected = expected_upload_provenance(
      app: app,
      build: build,
      bundle_id: bundle_id,
      version: version,
      build_number: build_number,
      source_commit: source_commit,
      ipa_sha256: ipa_sha256
    )
    path = required_option(options, :upload_provenance_path)
    create_upload_provenance(path: path, expected: expected)
    require_upload_provenance(
      path: path,
      app: app,
      build: build,
      bundle_id: bundle_id,
      version: version,
      build_number: build_number,
      source_commit: source_commit,
      ipa_sha256: ipa_sha256
    )
    UI.success("Recorded immutable provenance for the exact external build")
  end

  desc "Associate an exact build with only the approved immutable group ID"
  lane :associate_external_build do |options|
    app = connect_api_app(options)
    bundle_id = required_option(options, :bundle_id)
    group = exact_external_group(
      app: app,
      group_name: required_option(options, :group_name),
      group_id: required_option(options, :group_id),
      internal_group_name: required_option(options, :internal_group_name),
      internal_group_id: required_option(options, :approved_internal_group_id),
      internal_tester_id: required_option(options, :internal_tester_id),
      external_tester_count: required_option(options, :external_tester_count),
      external_tester_ids_sha256: required_option(
        options,
        :external_tester_ids_sha256
      )
    )
    approved_internal_group_id = required_option(
      options,
      :approved_internal_group_id
    )
    version = required_option(options, :version)
    build_number = required_option(options, :build_number)
    source_commit = required_option(options, :source_commit)
    ipa_sha256 = required_option(options, :ipa_sha256)
    build = exact_valid_build(
      app: app,
      version: version,
      build_number: build_number
    )
    require_app_store_eligible_build(build)
    require_upload_provenance(
      path: required_option(options, :upload_provenance_path),
      app: app,
      build: build,
      bundle_id: bundle_id,
      version: version,
      build_number: build_number,
      source_commit: source_commit,
      ipa_sha256: ipa_sha256
    )
    require_external_beta_review_metadata(app: app)
    build = disable_automatic_notification(build)
    require_no_individual_testers(build)

    associated = require_exact_external_association(
      app: app,
      build: build,
      approved_group: group,
      approved_internal_group_id: approved_internal_group_id,
      required: false
    )
    already_associated = associated.any? { |candidate| candidate.id == group.id }
    if build.ready_for_beta_submission?
      build.post_beta_app_review_submission
      UI.important("Submitted the exact build for external beta review")
    end
    require_external_beta_review_submission(build: build)
    build.add_beta_groups(beta_groups: [group]) unless already_associated
    associated = require_exact_external_association(
      app: app,
      build: build,
      approved_group: group,
      approved_internal_group_id: approved_internal_group_id,
      required: true
    )
    require_no_individual_testers(build)
    require_app_store_eligible_build(build)
    UI.success("Associated the exact build with only the approved group ID")
  end

  desc "Verify the immutable audience and notify it after external beta approval"
  lane :notify_external_build do |options|
    app = connect_api_app(options)
    bundle_id = required_option(options, :bundle_id)
    group = exact_external_group(
      app: app,
      group_name: required_option(options, :group_name),
      group_id: required_option(options, :group_id),
      internal_group_name: required_option(options, :internal_group_name),
      internal_group_id: required_option(options, :approved_internal_group_id),
      internal_tester_id: required_option(options, :internal_tester_id),
      external_tester_count: required_option(options, :external_tester_count),
      external_tester_ids_sha256: required_option(
        options,
        :external_tester_ids_sha256
      )
    )
    approved_internal_group_id = required_option(
      options,
      :approved_internal_group_id
    )
    version = required_option(options, :version)
    build_number = required_option(options, :build_number)
    build = exact_valid_build(
      app: app,
      version: version,
      build_number: build_number
    )
    require_app_store_eligible_build(build)
    upload_provenance = require_upload_provenance(
      path: required_option(options, :upload_provenance_path),
      app: app,
      build: build,
      bundle_id: bundle_id,
      version: version,
      build_number: build_number,
      source_commit: required_option(options, :source_commit)
    )
    build = disable_automatic_notification(build)
    associated = require_exact_external_association(
      app: app,
      build: build,
      approved_group: group,
      approved_internal_group_id: approved_internal_group_id,
      required: true
    )
    require_no_individual_testers(build)
    require_app_store_eligible_build(build)

    detail = build.build_beta_detail
    receipt_path = required_option(options, :notification_receipt_path)
    expected_receipt = expected_notification_receipt(
      app: app,
      build: build,
      group: group,
      approved_internal_group_id: approved_internal_group_id,
      associated_group_ids: associated.map(&:id),
      external_tester_count: required_option(options, :external_tester_count),
      external_tester_ids_sha256: required_option(
        options,
        :external_tester_ids_sha256
      ),
      bundle_id: bundle_id,
      version: version,
      build_number: build_number,
      source_commit: required_option(options, :source_commit),
      ipa_sha256: upload_provenance["ipaSha256"]
    )
    if notification_receipt_state(
      path: receipt_path,
      expected: expected_receipt
    ) == :complete
      UI.success("Verified the durable notification receipt for the exact build")
      next
    end
    if build.ready_for_beta_submission?
      UI.user_error!(
        "The exact build still requires beta-review submission. Run the " \
        "association lane before using notify-only mode."
      )
    end
    eligible_states = [
      Spaceship::ConnectAPI::BuildBetaDetail::ExternalState::READY_FOR_BETA_TESTING,
      Spaceship::ConnectAPI::BuildBetaDetail::ExternalState::BETA_APPROVED,
      Spaceship::ConnectAPI::BuildBetaDetail::ExternalState::IN_BETA_TESTING
    ]
    unless eligible_states.include?(detail.external_build_state)
      UI.user_error!(
        "The exact build is not ready to notify (external state: " \
        "#{detail.external_build_state}). Re-run in notify-only mode after approval."
      )
    end

    # Claim the exact release durably before the build-scoped, non-idempotent
    # notification request. Existing pending or complete records prevent a
    # concurrent runner from posting. The audience is then rechecked with the
    # claim held immediately before the single request attempt.
    claim_id = create_notification_claim(
      path: receipt_path,
      expected: expected_receipt
    )
    group = exact_external_group(
      app: app,
      group_name: required_option(options, :group_name),
      group_id: required_option(options, :group_id),
      internal_group_name: required_option(options, :internal_group_name),
      internal_group_id: approved_internal_group_id,
      internal_tester_id: required_option(options, :internal_tester_id),
      external_tester_count: required_option(options, :external_tester_count),
      external_tester_ids_sha256: required_option(
        options,
        :external_tester_ids_sha256
      )
    )
    require_exact_external_association(
      app: app,
      build: build,
      approved_group: group,
      approved_internal_group_id: approved_internal_group_id,
      required: true
    )
    require_no_individual_testers(build)
    require_app_store_eligible_build(build)
    begin
      response = post_build_beta_notification_once(
        request_client: Spaceship::ConnectAPI.client.test_flight_request_client,
        build_id: build.id
      )
    rescue StandardError => error
      UI.user_error!(
        "The notification request had an ambiguous failure (#{error.class}); " \
        "the durable claim remains pending. Do not retry until the release " \
        "owner reconciles App Store Connect."
      )
    end
    UI.user_error!(
      "App Store Connect did not confirm tester notification; the durable " \
      "claim remains pending. Do not retry until the release owner reconciles " \
      "App Store Connect."
    ) unless
      response[:status] == 201 &&
        response[:body].dig("data", "type") == "buildBetaNotifications"
    notification_id = response[:body].dig("data", "id").to_s.strip
    UI.user_error!(
      "App Store Connect returned no notification ID; the durable claim " \
      "remains pending. Do not retry until the release owner reconciles " \
      "App Store Connect."
    ) if notification_id.empty?
    complete_notification_claim(
      path: receipt_path,
      expected: expected_receipt,
      claim_id: claim_id,
      notification_id: notification_id
    )
    UI.success("Notified testers assigned only to the approved group")
  end
end
