# Example environment for scripts/testflight.sh. The script deliberately does
# not source this file. Export reviewed values in the release shell.

# App Store Connect API key (developer.apple.com / appstoreconnect.apple.com)
ASC_API_KEY_ID="XXXXXXXXXX"
ASC_API_ISSUER_ID="00000000-0000-0000-0000-000000000000"
APPLE_TEAM_ID="XXXXXXXXXX"

# Path to a mode-400 or mode-600 .p8 private key.
# ASC_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_${ASC_API_KEY_ID}.p8"

# iOS bundle identifier of the app to upload
APP_BUNDLE_ID="com.example.app"
LIVE_ACTIVITY_BUNDLE_ID="com.example.app.liveActivity"

# Exact Flutter/Dart, Fastlane, Xcode, and CocoaPods versions are checked
# against repository-owned constants; release operators cannot override them.

# Exact existing external TestFlight group. Any internal or external group with
# automatic build access is rejected before upload. A build with any other
# associated group or individually assigned tester is also rejected.
# The script resolves this group's immutable ID before upload and uses the ID
# for the actual build association.
TESTFLIGHT_GROUP="External Testers"

# Set this to the immutable ID printed by the original run only when safely
# resuming notification after App Store Connect beta review. Notify-only mode
# never uploads or re-associates the build.
# TESTFLIGHT_GROUP_ID="00000000-0000-0000-0000-000000000000"
# TESTFLIGHT_NOTIFY_ONLY="yes"

# Durable one-shot claim and receipt for the exact build notification. Create
# its parent directory with mode 700 outside the repository. The lane writes a
# pending claim before the request and atomically marks it complete only after a
# confirmed response. Never run concurrently or retry a pending claim.
TESTFLIGHT_NOTIFICATION_RECEIPT_PATH="/secure/openglucose/releases/0.1.0+17-notification.json"

# Immutable source identity; both values must match the clean worktree.
RELEASE_VERSION="0.1.0+17"
RELEASE_COMMIT="full-40-character-git-commit"

# Distribution is fail-closed unless both gates are exactly "yes".
RELEASE_APPROVED="no"
DISTRIBUTE_EXTERNAL="no"

TESTFLIGHT_CHANGELOG="Describe the user-visible changes in this build."
