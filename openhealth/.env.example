# Copy to `.env` and fill in. `.env` is gitignored.
# Used by scripts/testflight.sh.

# App Store Connect API key (developer.apple.com / appstoreconnect.apple.com)
ASC_API_KEY_ID="XXXXXXXXXX"
ASC_API_ISSUER_ID="00000000-0000-0000-0000-000000000000"

# Path to the .p8 private key file. Default: ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
# ASC_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_${ASC_API_KEY_ID}.p8"

# iOS bundle identifier of the app to upload
APP_BUNDLE_ID="com.example.app"

# External TestFlight group to auto-submit to (created on first run if missing)
TESTFLIGHT_GROUP="External Testers"

# Default changelog text (override per-run by exporting TESTFLIGHT_CHANGELOG)
TESTFLIGHT_CHANGELOG="Latest build."
